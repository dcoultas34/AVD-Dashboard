// =============================================================================
// Session History - Active and Disconnected concurrent sessions per time bin
// =============================================================================
//
// DATA SOURCE: WVDAgentHealthStatus
//   Written by each AVD session host agent every ~30 seconds. Each row is a
//   health snapshot for one session host containing ActiveSessions and
//   InactiveSessions counts at that exact moment.
//
// AGGREGATION METHOD (two-stage):
//   Because each host writes a row every ~30 seconds, a single bin contains
//   many nearly-identical rows per host. We cannot simply sum all rows.
//
//   Stage 1 - per host per bin:
//     Use arg_max(TimeGenerated, ...) to get the most recent agent heartbeat
//     for each host within the bin. This gives a true point-in-time snapshot
//     rather than the peak, avoiding inflation from hosts peaking at different
//     moments within the same bin.
//
//   Stage 2 - sum across all hosts:
//     Sum the per-host latest readings to get the fleet-wide total for each bin.
//     This matches the Active/Disconnected counts on the Azure Portal host
//     pool overview because it uses the same data source and same aggregation.
//
// HOST POOL FILTER:
//   WVDAgentHealthStatus._ResourceId contains the full ARM path of the host pool.
//   Segment 8 (zero-indexed, split by '/') is the host pool name.
//   {{HostPoolFilter}} is replaced with a where clause or empty string.
//
// COLUMNS RETURNED:
//   TimeGenerated  - start of each time bin (UTC)
//   Active         - latest ActiveSessions per host summed across all hosts
//   Disconnected   - latest InactiveSessions per host summed across all hosts
//   Total          - Active + Disconnected (matches the dashboard Total Sessions card)
//
// PLACEHOLDERS:
//   {{DisplayStart}}   - e.g. "ago(48h)" or "datetime(2026-04-01T00:00:00Z)"
//   {{DisplayEnd}}     - e.g. "now()" or "datetime(2026-04-14T00:00:00Z)"
//   {{BinSize}}        - e.g. "5m", "15m", "30m", "1h", "4h", "1d"
//   {{HostPoolFilter}} - optional where clause, or empty string
// =============================================================================

// Stage 1: get the latest snapshot per host per bin using arg_max(TimeGenerated, ...).
// This picks the most recent agent heartbeat within the bin for each host, giving
// a true point-in-time reading rather than the peak. Summing point-in-time readings
// across hosts matches the live ARM snapshot shown in the dashboard header cards.
// Note: arg_max returns columns suffixed with the aggregation key name, so the
// projected columns are named after the original columns (ActiveSessions, InactiveSessions).
WVDAgentHealthStatus
| where TimeGenerated >= {{DisplayStart}} and TimeGenerated <= {{DisplayEnd}}
{{HostPoolFilter}}
| extend BinTime = bin(TimeGenerated, {{BinSize}})
| summarize arg_max(TimeGenerated, ActiveSessions, InactiveSessions) by SessionHostName, BinTime
// Stage 2: sum the per-host latest readings across all hosts to get fleet-wide totals
| summarize
    Active       = sum(toint(ActiveSessions)),
    Disconnected = sum(toint(InactiveSessions))
  by TimeGenerated = BinTime
| extend Total = Active + Disconnected
| order by TimeGenerated desc
