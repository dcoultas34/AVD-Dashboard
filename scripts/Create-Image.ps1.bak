<#
.SYNOPSIS
    Create-Image.ps1 — Builds and seals an AVD preparation VM, publishes it to the
    Shared Image Gallery, monitors gallery replication, and cleans up afterwards.

.DESCRIPTION
    Full AVD gold image pipeline (formerly split across Stage 1 and Stage 2):

    Stage 1 - Preparation VM Build
      - Stops the master image VM
      - Takes a snapshot backup
      - Removes any existing preparation VM (with retry logic for disk/NIC cleanup)
      - Creates a new preparation VM from the snapshot
      - Runs BIS-F sealing and Sysprep (if extension enabled)
      - Waits for the VM to shut down and deallocate
      - Generalises the VM and submits a new image version to the Shared Image Gallery

    Stage 2 - Gallery Monitor and Cleanup
      - Polls the gallery image version until ProvisioningState = Succeeded
      - Removes the preparation VM, OS disk, NIC, and snapshot once replication is complete

.NOTES
    Version : 2026-04-28
    Author  : andrew.webber@ultima.com
    History :
        2026-04-28 - Initial version
#>

#Display current path
$path = Get-Location
Write-Host "Path: $path"

$WarningPreference = 'SilentlyContinue'

# ==========================================
# Default Variables
# ==========================================
$ImageStorageAccountType = "Standard_LRS"
$ImageReplicaCount       = 1
$BisfTimeoutMinutes      = 15
$SysprepTimeoutMinutes   = if ($env:TIMEOUTINMINUTES) { [int]$env:TIMEOUTINMINUTES } else { 35 }
# Example: $vmTags = @{ "Creator" = ""; "Owner" = "IT Operations"; "Environment" = "Production"; "CreatedBy" = ""; "Service" = "" }
$vmTags = @{}
$PrepVMSize = $env:PrepVMSize

# ==========================================
# Pipeline Variables
# ==========================================
Write-Host "== Setting Variables from pipeline input =="

$AVD                        = "yes"
$extension                  = $env:EXTENSION
Write-Host "BIS-F Extension $extension"
$ResourceGroupName          = $env:IMAGE_RG_NAME
Write-Host "ResourceGroupName: $ResourceGroupName"
$Location                   = $env:LOCATION
Write-Host "Location: $Location"
$NicResourceGroupName       = $env:NET_RG_NAME
Write-Host "NicResourceGroupName: $NicResourceGroupName"
$vNetName                   = $env:VNET_NAME
Write-Host "vNetName: $vNetName"
$SubnetName                 = $env:SUBNET_NAME
$MasterVM                   = $env:IMAGE_VM_NAME
Write-Host "MasterVM: $MasterVM"
$galleryName                = $env:GALLERY_NAME
Write-Host "GalleryName: $galleryName"
$galleryImageDefinitionName = $env:IMAGE_DEF_NAME
Write-Host "GalleryImageDefinitionName: $galleryImageDefinitionName"

$PrepVmName  = $MasterVM + '_Prep'
$Now         = Get-Date -UFormat "%Y%m%d_%H%M"
$snapshotName = $MasterVM + "_$Now"
Write-Host "SnapshotName: $snapshotName"

# AVD replica regions for the gallery image version — uksouth-only pool gets a single replica
if ($MasterVM -eq '') {
    $arrLocations = @(
        @{Name='uksouth'; ReplicaCount=1; StorageAccountType='Standard_LRS'}
    )
} else {
    $arrLocations = @(
        @{Name='westeurope';       ReplicaCount=1; StorageAccountType='Standard_LRS'},
        @{Name='northeurope';        ReplicaCount=3; StorageAccountType='Standard_LRS'}
    )
}

# ==========================================
# STAGE 1 - Preparation VM Build
# ==========================================

# Stop Master VM
Write-Host ; Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host " Stopping and Deallocating Master Image " -NoNewline ; Write-Host $MasterVM -ForegroundColor Cyan
Stop-AzVM -ResourceGroupName $ResourceGroupName -Name $MasterVM -Force | Out-Null

# Get VM Info
$vm = Get-AzVM -ResourceGroupName $ResourceGroupName -Name $MasterVM

# Create Snapshot backup of the master image OS disk
$snapshot = New-AzSnapshotConfig -SourceUri $vm.StorageProfile.OsDisk.ManagedDisk.Id -Location $location -CreateOption copy -EncryptionType EncryptionAtRestWithPlatformKey

Write-Host ; Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host " Taking Snapshot Backup of Master Image called " -NoNewline ; Write-Host $snapshotName -ForegroundColor Cyan
New-AzSnapshot -Snapshot $snapshot -SnapshotName $snapshotName -ResourceGroupName $ResourceGroupName | Out-Null

$snapshot = Get-AzSnapshot -ResourceGroupName $ResourceGroupName -SnapshotName $snapshotName

# Remove any existing preparation VM before creating a fresh one
$testVM = Get-AzVM -ResourceGroupName $ResourceGroupName -Name $PrepVmName -ErrorAction SilentlyContinue
If ($testVM) {
    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Remove Existing Preparation VM from Azure" -ForegroundColor DarkYellow

    # Capture disk and NIC details before VM deletion while $testVM data is still valid
    $diskName = $testVM.StorageProfile.OsDisk.Name
    $Nic      = Get-AzNetworkInterface -ResourceID $testVM.NetworkProfile.NetworkInterfaces.id

    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "     Remove Existing VM" -ForegroundColor DarkYellow
    Remove-AzVM -ResourceGroupName $resourceGroupName -Name $PrepVMName -Force | Out-Null

    # Wait for VM to be fully deleted before attempting disk/NIC removal.
    # Remove-AzVM can return before Azure releases locks on attached resources.
    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "     Waiting for VM to be fully deleted..." -ForegroundColor DarkYellow
    $vmGoneTimeout = 120
    $vmGoneTimer   = [Diagnostics.Stopwatch]::StartNew()
    do {
        Start-Sleep -Seconds 10
        $checkVm = Get-AzVM -ResourceGroupName $resourceGroupName -Name $PrepVMName -ErrorAction SilentlyContinue
    } while ($checkVm -and $vmGoneTimer.Elapsed.TotalSeconds -lt $vmGoneTimeout)

    if ($checkVm) {
        throw "VM $PrepVMName still exists after $vmGoneTimeout seconds - cannot safely delete disk/NIC"
    }

    # Remove OS Disk with retry
    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "     Remove Existing OS Disk: $diskName" -ForegroundColor DarkYellow
    $maxRetries = 3
    for ($attempt = 1; $attempt -le $maxRetries; $attempt++) {
        try {
            Remove-AzDisk -ResourceGroupName $resourceGroupName -DiskName $diskName -Force -ErrorAction Stop | Out-Null
            Write-Host "     Disk removed successfully" -ForegroundColor Green
            break
        } catch {
            Write-Host "     Disk removal attempt $attempt failed: $($_.Exception.Message)" -ForegroundColor Yellow
            if ($attempt -eq $maxRetries) { throw "Failed to remove disk $diskName after $maxRetries attempts" }
            Start-Sleep -Seconds 15
        }
    }

    # Remove NIC with retry
    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "     Remove Existing NIC: $($Nic.Name)" -ForegroundColor DarkYellow
    for ($attempt = 1; $attempt -le $maxRetries; $attempt++) {
        try {
            Remove-AzNetworkInterface -ResourceGroupName $resourceGroupName -Name $Nic.Name -Force -ErrorAction Stop | Out-Null
            Write-Host "     NIC removed successfully" -ForegroundColor Green
            break
        } catch {
            Write-Host "     NIC removal attempt $attempt failed: $($_.Exception.Message)" -ForegroundColor Yellow
            if ($attempt -eq $maxRetries) { throw "Failed to remove NIC $($Nic.Name) after $maxRetries attempts" }
            Start-Sleep -Seconds 15
        }
    }
}

# Create Clone of Master Image from Snapshot
Write-Host ; Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host " Creating Preparation VM " -NoNewline ; Write-Host $PrepVmName -ForegroundColor Cyan
Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Creating OS Disk from Snapshot" -ForegroundColor DarkYellow
$diskconfig = New-AzDiskConfig -Location $Location -SourceResourceId $snapshot.Id -CreateOption Copy -SkuName Premium_LRS

$DiskName = $PrepVmName + '_OSdisk'
$newdisk  = New-AzDisk -Disk $diskconfig -ResourceGroupName $ResourceGroupName -DiskName $DiskName

$vmconfig = New-AzVMConfig -VMName $PrepVmName -VMSize $PrepVMSize
$vmconfig = Set-AzVMOSDisk -VM $vmconfig -ManagedDiskId $newdisk.Id -CreateOption Attach -Windows

Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Creating NIC" -ForegroundColor DarkYellow
$vnet    = Get-AzVirtualNetwork -Name $vNetName -ResourceGroupName $NicResourceGroupName
$subnet  = Get-AzVirtualNetworkSubnetConfig -Name $SubnetName -VirtualNetwork $vnet

$nicName = $PrepVmName + '-nic'
$vmnic   = New-AzNetworkInterface -Name $nicName -ResourceGroupName $ResourceGroupName -Location $Location -SubnetId $subnet.Id -EnableAcceleratedNetworking

$vmconfig = Add-AzVMNetworkInterface -VM $vmconfig -Id $vmnic.Id
$vmconfig = Set-AzVMBootDiagnostic -VM $vmconfig -Disable
$vmconfig = Set-AzVMSecurityProfile -VM $vmconfig -SecurityType TrustedLaunch

Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Deploying Preparation VM" -ForegroundColor Yellow
New-AzVM -VM $vmconfig -ResourceGroupName $ResourceGroupName -Location $Location -Tag $vmTags -DisableBginfoExtension

# Grab the IP of the PrepVM in case manual access is needed
$vmnic     = Get-AzNetworkInterface -ResourceGroupName $ResourceGroupName -Name $nicName
$ipAddress = $vmnic.IpConfigurations[0].PrivateIpAddress

Write-Host
Write-Host "##[section]=========================================="
Write-Host "##[section]Preparation VM: $PrepVmName"
Write-Host "##[section]IP Address: $ipAddress"
Write-Host "##[section]=========================================="

# ==========================================
# STAGE 2 - Sealing Script and Gallery Version
# ==========================================

$runExtension = [System.Convert]::ToBoolean($env:EXTENSION)

if ($runExtension) {
    Write-Host
    Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewLine
    Write-Host " Running Sealing script on " -NoNewline
    Write-Host $PrepVMName -ForegroundColor Cyan

    $job = Start-Job -ScriptBlock {
        Invoke-AzVMRunCommand `
            -ResourceGroupName $using:ResourceGroupName `
            -VMName $using:PrepVMName `
            -CommandId 'RunPowerShellScript' `
            -ScriptString '& "C:\_Source\BIS-F\Framework\PrepBISF_Start.ps1"'
    }

    $bisfTimer = [Diagnostics.Stopwatch]::StartNew()

    while ($job.State -eq 'Running') {
        if ($bisfTimer.Elapsed.TotalMinutes -gt $BisfTimeoutMinutes) {
            $job | Stop-Job
            $job | Remove-Job -Force
            throw "BIS-F timed out after $BisfTimeoutMinutes minutes on $PrepVMName - BIS-F may have hung."
        }
        Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewline
        Write-Host " Still running BIS-F... ($([math]::Round($bisfTimer.Elapsed.TotalMinutes, 1)) min / $BisfTimeoutMinutes min timeout)"
        Start-Sleep -Seconds 60
    }

    $bisfTimer.Stop()
    $bisf = Receive-Job $job -Wait
    Remove-Job $job
    Write-Host $bisf.Value[0].Message
}

if ($runExtension) {
    Write-Host
    Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewLine
    Write-Host " Running Sysprep on " -NoNewline
    Write-Host $PrepVMName -ForegroundColor Cyan

    $sysprepJob = Invoke-AzVMRunCommand `
        -ResourceGroupName $ResourceGroupName `
        -VMName $PrepVMName `
        -CommandId 'RunPowerShellScript' `
        -ScriptString @'
$sysprep = Start-Process -FilePath 'C:\Windows\System32\Sysprep\sysprep.exe' `
    -ArgumentList '/generalize /oobe /shutdown /quiet' -PassThru

Write-Output "Sysprep started (PID: $($sysprep.Id))"

$logPath = 'C:\Windows\System32\Sysprep\Panther\setuperr.log'
$lastPos  = 0

# Wait up to 60s for the log to appear
$waited = 0
while (-not (Test-Path $logPath) -and $waited -lt 60) {
    Start-Sleep -Seconds 2
    $waited += 2
}

# Poll for new log content while sysprep runs
while (-not $sysprep.HasExited) {
    if (Test-Path $logPath) {
        $fs = [System.IO.File]::Open($logPath, 'Open', 'Read', 'ReadWrite')
        $fs.Seek($lastPos, 'Begin') | Out-Null
        $sr = New-Object System.IO.StreamReader($fs)
        $new = $sr.ReadToEnd()
        $lastPos = $fs.Position
        $sr.Close(); $fs.Close()
        if ($new) { Write-Output $new }
    }
    Start-Sleep -Seconds 5
}

# Final drain after exit
if (Test-Path $logPath) {
    $fs = [System.IO.File]::Open($logPath, 'Open', 'Read', 'ReadWrite')
    $fs.Seek($lastPos, 'Begin') | Out-Null
    $sr = New-Object System.IO.StreamReader($fs)
    $new = $sr.ReadToEnd()
    $sr.Close(); $fs.Close()
    if ($new) { Write-Output $new }
}

Write-Output "Sysprep exit code: $($sysprep.ExitCode)"
'@ `
        -AsJob

    $sysprepTimer = [Diagnostics.Stopwatch]::StartNew()
    $sysprepTimeoutSeconds = $SysprepTimeoutMinutes * 60

    while ($sysprepJob.State -eq 'Running') {
        if ($sysprepTimer.Elapsed.TotalSeconds -gt $sysprepTimeoutSeconds) {
            $sysprepJob | Stop-Job
            $sysprepJob | Remove-Job -Force
            throw "Sysprep timed out after $SysprepTimeoutMinutes minutes on $PrepVMName - Sysprep may have hung. Check C:\Windows\System32\Sysprep\Panther\setuperr.log on the VM."
        }
        Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewline
        Write-Host " Still running Sysprep... ($([math]::Round($sysprepTimer.Elapsed.TotalMinutes, 1)) min / $SysprepTimeoutMinutes min timeout)"
        Start-Sleep -Seconds 60
    }

    $sysprepTimer.Stop()
    $sysprepResult = Receive-Job $sysprepJob -Wait
    Remove-Job $sysprepJob

    Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewLine
    Write-Host " Sysprep completed - output:"
    Write-Host $sysprepResult.Value[0].Message
}

# If extension is not run, set BIS-F registry keys and local policy via Run Command
if (!$runExtension) {
    Write-Host
    Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewLine
    Write-Host " Setting allow RDP for BIS-F registry keys on " -NoNewline
    Write-Host $PrepVMName -ForegroundColor Cyan

    try {
        Invoke-AzVMRunCommand `
            -ResourceGroupName $ResourceGroupName `
            -VMName $PrepVMName `
            -CommandId "RunPowerShellScript" `
            -ScriptString @"
Write-Host "Creating registry key..."
New-Item -Path 'HKLM:\SOFTWARE\Policies\Login Consultants\BISF' -Force | Out-Null
Write-Host "Setting LIC_BISF_CLI_ST..."
Set-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Login Consultants\BISF' -Name 'LIC_BISF_CLI_ST' -Value 'YES' -Type String -Force
Write-Host "Setting LIC_BISF_POL_ST..."
Set-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Login Consultants\BISF' -Name 'LIC_BISF_POL_ST' -Value 1 -Type DWord -Force
Write-Host "Verifying registry..."
Get-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Login Consultants\BISF'
Write-Host "Installing PolicyFileEditor..."
Install-PackageProvider -Name NuGet -Force -Scope CurrentUser
Install-Module -Name PolicyFileEditor -Force -Scope AllUsers -SkipPublisherCheck
Import-Module PolicyFileEditor
Write-Host "Setting pol file entries..."
Set-PolicyFileEntry -Path 'C:\Windows\System32\GroupPolicy\Machine\Registry.pol' -Key 'SOFTWARE\Policies\Login Consultants\BISF' -ValueName 'LIC_BISF_CLI_ST' -Data 'YES' -Type String
Set-PolicyFileEntry -Path 'C:\Windows\System32\GroupPolicy\Machine\Registry.pol' -Key 'SOFTWARE\Policies\Login Consultants\BISF' -ValueName 'LIC_BISF_POL_ST' -Data 1 -Type DWord
Write-Host "Running gpupdate..."
gpupdate /force
Write-Host "Uninstalling PolicyFileEditor..."
Remove-Module PolicyFileEditor -Force
Uninstall-Module -Name PolicyFileEditor -Force
Write-Host "Done"
"@ `
            -ErrorAction Stop

        Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewLine
        Write-Host " BIS-F registry keys set successfully on " -NoNewline
        Write-Host $PrepVMName -ForegroundColor Green
    }
    catch {
        Write-Host (Get-Date -Format HH:mm:ss) -ForegroundColor Gray -NoNewLine
        Write-Host " ERROR: BIS-F registry key extension failed on " -NoNewline
        Write-Host $PrepVMName -ForegroundColor Red
        Write-Host $_.Exception.Message -ForegroundColor Red
        throw
    }
}

Write-Host "Waiting for VM to be shutdown by SysPrep..." -ForegroundColor Yellow

# Poll until the VM reaches PowerState/stopped; warn after SysprepTimeoutMinutes
$timeout   = New-TimeSpan -Minutes $SysprepTimeoutMinutes
$stopwatch = [System.Diagnostics.Stopwatch]::StartNew()

do {
    Start-Sleep -Seconds 90
    $vmStatus   = Get-AzVM -ResourceGroupName $resourceGroupName -Name $PrepVMName -Status
    $powerState = ($vmStatus.Statuses | Where-Object { $_.Code -like "PowerState/*" }).Code

    $elapsed = $stopwatch.Elapsed
    Write-Host "  Current state: $powerState (Elapsed: $($elapsed.ToString('mm\:ss')))" -ForegroundColor Gray

    if ($stopwatch.Elapsed -ge $timeout) {
        if ($runExtension) {
            Write-Host "  VM Name: $PrepVMName" -ForegroundColor Red
            Write-Host "  Resource Group: $resourceGroupName" -ForegroundColor Red
            throw "VM has not stopped after $SysprepTimeoutMinutes minutes. Sysprep may have failed. VM: $PrepVMName, RG: $resourceGroupName"
        } else {
            Write-Host "##vso[task.logissue type=warning]WARNING: VM has not stopped after 15 minutes. Waiting for manual intervention."
            Write-Host "  VM Name: $PrepVMName" -ForegroundColor Yellow
            Write-Host "  Resource Group: $resourceGroupName" -ForegroundColor Yellow
        }
    }
} while ($powerState -ne "PowerState/stopped")

$stopwatch.Stop()

if ($powerState -eq "PowerState/stopped") {
    Write-Host "  VM stopped successfully after $($stopwatch.Elapsed.ToString('mm\:ss'))" -ForegroundColor Green
}

Write-Host "VM has stopped (state: $powerState)" -ForegroundColor Green

Write-Host ; Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host " Deallocating Prep Image VM " -NoNewline ; Write-Host $PrepVMName -ForegroundColor Cyan
Stop-AzVM -ResourceGroupName $resourceGroupName -Name $PrepVMName -Force

# Wait for VM to be fully deallocated before generalising
Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Waiting for VM to be deallocated..." -ForegroundColor DarkYellow
do {
    Start-Sleep -Seconds 5
    $vmStatus   = Get-AzVM -ResourceGroupName $resourceGroupName -Name $PrepVMName -Status
    $powerState = $vmStatus.Statuses | Where-Object { $_.Code -like "PowerState/*" } | Select-Object -ExpandProperty Code
    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Current state: $powerState" -ForegroundColor Gray
} while ($powerState -ne "PowerState/deallocated")

Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   VM is deallocated" -ForegroundColor Green

if ($AVD -eq "yes") {
    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Generalise Preparation VM" -ForegroundColor DarkYellow
    Set-AzVm -ResourceGroupName $resourceGroupName -Name $PrepVMName -Generalized | Out-Null
    (Get-AzVM `
      -ResourceGroupName $resourceGroupName `
      -Name $PrepVMName `
      -Status).Statuses
    Start-Sleep 10
}

$PrepVM = Get-AzVM -Name $PrepVMName -ResourceGroupName $resourceGroupName

# ==========================================
# STAGE 3 - Submit Gallery Image Version
# ==========================================

Write-Host ; Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host " Getting Details of Shared Image Gallery Definition " -NoNewline ; Write-Host $galleryImageDefinitionName -ForegroundColor Green
$GetSharedImageGalleryDefinition = Get-AzGalleryImageDefinition -ResourceGroupName $ResourceGroupName -GalleryName $galleryName -Name $galleryImageDefinitionName -ErrorAction Stop

# Version format: yyyyMM.dd.HHmm — output as pipeline variables for the monitoring stage
$Version = Get-Date -Format "yyyyMM.dd.HHmm"
Write-Host "##vso[task.setvariable variable=Version;isOutput=true]$Version"
Write-Host "##vso[task.setvariable variable=snapshotName;isOutput=true]$snapshotName"

Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Version Number is: " -NoNewLine ; Write-Host $Version -ForegroundColor DarkYellow

$SourceID = $PrepVM.Id.ToString()

Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Adding Image to Shared Image Gallery " -NoNewline ; Write-Host "(via asJob)" -ForegroundColor DarkYellow

Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Gallery Image Version Parameters" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Gallery Image Definition Name: $($GetSharedImageGalleryDefinition.Name)" -ForegroundColor White
Write-Host "Gallery Image Version Name:    $Version" -ForegroundColor White
Write-Host "Gallery Name:                  $galleryName" -ForegroundColor White
Write-Host "Resource Group Name:           $ResourceGroupName" -ForegroundColor White
Write-Host "Location:                      $Location" -ForegroundColor White
Write-Host "Storage Account Type:          $ImageStorageAccountType" -ForegroundColor White
Write-Host "Replica Count:                 $ImageReplicaCount" -ForegroundColor White
Write-Host "Source Image VM ID:            $SourceID" -ForegroundColor White
Write-Host "End of Life Date:              $((Get-Date).ToUniversalTime().AddMonths(12).ToString('yyyy-MM-dd'))" -ForegroundColor White
Write-Host "Target Regions:" -ForegroundColor Yellow
$arrLocations | ForEach-Object {
    Write-Host "  - Name: $($_.Name), Replicas: $($_.ReplicaCount), Storage: $($_.StorageAccountType)" -ForegroundColor White
}
Write-Host "========================================" -ForegroundColor Cyan

$galleryJob = New-AzGalleryImageVersion -GalleryImageDefinitionName $GetSharedImageGalleryDefinition.Name `
    -GalleryImageVersionName $Version `
    -GalleryName $galleryName `
    -StorageAccountType $ImageStorageAccountType `
    -ReplicaCount $ImageReplicaCount `
    -ResourceGroupName $ResourceGroupName `
    -Location $Location `
    -TargetRegion $arrLocations `
    -SourceImageVMId $SourceID `
    -PublishingProfileEndOfLifeDate $((Get-Date).ToUniversalTime().AddMonths(12).ToString('yyyy-MM-dd')) `
    -AsJob

# Monitor the gallery job for 60 seconds — if still running after that, continue to the polling loop
Write-Output "Gallery job started, monitoring for 60 seconds..."
Write-Output "Initial job state: $($galleryJob.State)"

$monitorTimer = [Diagnostics.Stopwatch]::StartNew()
while ($galleryJob.State -in @('Running', 'NotStarted') -and $monitorTimer.Elapsed.TotalSeconds -lt 60) {
    Write-Output "Job state: $($galleryJob.State) - ($([math]::Round($monitorTimer.Elapsed.TotalSeconds)) seconds elapsed)"
    Start-Sleep -Seconds 10
}
$monitorTimer.Stop()
Write-Output "Job state after initial 60s monitor: $($galleryJob.State)"

if ($galleryJob.State -eq 'Failed') {
    $errors = $galleryJob.ChildJobs[0].Error
    foreach ($err in $errors) { Write-Error $err }
    $galleryJob | Remove-Job -Force
    throw "Image version creation failed immediately"
}
$galleryJob | Remove-Job -Force

# ==========================================
# STAGE 4 - Gallery Monitor and Cleanup
# ==========================================

Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine
Write-Host "   Checking Status of Deployment in Azure Portal," -NoNewline
Write-Host " This can take up to 30 minutes to complete" -ForegroundColor DarkYellow

Get-AzGalleryImageVersion -ResourceGroupName $ResourceGroupName -GalleryImageDefinitionName $galleryImageDefinitionName -GalleryName $galleryName | Where-Object { $_.Name -eq $Version }

# Poll until the gallery image version reaches ProvisioningState = Succeeded
Start-Sleep -Seconds 30
do {
    $Status = Get-AzGalleryImageVersion -ResourceGroupName $ResourceGroupName -GalleryImageDefinitionName $galleryImageDefinitionName -GalleryName $galleryName | Where-Object { $_.Name -eq $Version }
    if (!$Status) {
        Write-Error "Failed to find a running Deployment."
    }
    if ($Status.ProvisioningState -eq 'Failed') {
        Write-Error "Deployment Failed - check Azure Activity Logs for details"
    }
    Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Current Status is: " -NoNewline
    if ($Status.ProvisioningState -ne 'Succeeded') {
        Write-Host $Status.ProvisioningState -ForegroundColor DarkCyan
        Start-Sleep -Seconds 60
    }
} while ($Status.ProvisioningState -ne 'Succeeded')

Write-Host 'Succeeded' -ForegroundColor Cyan

# Clean up the preparation VM, OS disk, NIC and snapshot now that replication is complete
$vm = Get-AzVM -Name $PrepVMName -ResourceGroupName $resourceGroupName

Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Remove Preparation VM from Azure" -ForegroundColor DarkYellow
Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "     Remove VM" -ForegroundColor DarkYellow
Remove-AzVM -ResourceGroupName $resourceGroupName -Name $PrepVMName -Force | Out-Null
Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "     Remove OS Disk" -ForegroundColor DarkYellow
Remove-AzDisk -ResourceGroupName $resourceGroupName -DiskName $vm.StorageProfile.OsDisk.Name -Force | Out-Null
Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "     Remove NIC" -ForegroundColor DarkYellow
$Nic = Get-AzNetworkInterface -ResourceID $vm.NetworkProfile.NetworkInterfaces.id
Remove-AzNetworkInterface -ResourceGroupName $resourceGroupName -Name $Nic.Name -Force | Out-Null
Write-Host $(Get-Date -Format HH:mm:ss:) -ForegroundColor Gray -NoNewLine ; Write-Host "   Remove Snapshot" -ForegroundColor DarkYellow
Remove-AzSnapshot -SnapshotName $snapshotName -ResourceGroupName $ResourceGroupName -Force | Out-Null

Write-Host
Write-Host "##[section]=========================================="
Write-Host "##[section]Image pipeline complete"
Write-Host "##[section]Version: $Version"
Write-Host "##[section]=========================================="
